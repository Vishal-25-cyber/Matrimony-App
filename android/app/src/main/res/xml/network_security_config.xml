<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production Base Configuration: Strict HTTPS only for all public internet traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Development Fallbacks: Cleartext permitted ONLY for local host loopbacks during local dev -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.1.32.156</domain>
    </domain-config>
</network-security-config>
