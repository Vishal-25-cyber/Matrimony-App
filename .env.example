# ==============================================================================
# PANDARATHAR MATRIMONY APP - EXAMPLE ENVIRONMENT FILE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare R2 Storage (Profile Photos & Horoscope Certificates)
# ------------------------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=matrimony-profile-images
CLOUDFLARE_R2_PREFIX=profiles/
CLOUDFLARE_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL_PREFIX=https://pub-r2.pandarathar-matrimony.com

# ------------------------------------------------------------------------------
# 2. MongoDB Database Configuration
# ------------------------------------------------------------------------------
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/pandarathar_matrimony
MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pandarathar_matrimony?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. UPI & Payment Gateway Configuration
# ------------------------------------------------------------------------------
UPI_ID=9842199999@okaxis
UPI_PAYEE_NAME=Pandarathar Matrimony Trust
UNLOCK_CONTACT_FEE_INR=25

# ------------------------------------------------------------------------------
# 4. App & Support Configuration
# ------------------------------------------------------------------------------
APP_ENV=production
SUPPORT_PHONE=+91 98421 99999
SUPPORT_EMAIL=support@pandarathar-matrimony.com
